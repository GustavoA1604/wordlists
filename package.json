{
  "name": "wordlists",
  "version": "0.1.0",
  "description": "Curated, source-controlled word lists (PT-BR) for word games.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node --max-old-space-size=6000 pt-br/build.js",
    "word": "node --max-old-space-size=6000 pt-br/word.js",
    "move": "node --max-old-space-size=6000 pt-br/move.js",
    "lint-curated": "node --max-old-space-size=6000 pt-br/lint-curated.js",
    "candidates": "node pt-br/gen-candidates.js",
    "verb-gap": "node pt-br/gen-verb-candidates.js",
    "verb-gap:network": "node pt-br/fetch-conjugations.js",
    "analyze": "node pt-br/analyze.js",
    "compile-morphobr": "node --max-old-space-size=6000 pt-br/compile-morphobr.js",
    "test": "node --max-old-space-size=6000 --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
