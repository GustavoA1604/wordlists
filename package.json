{
  "name": "wordlists",
  "version": "0.1.0",
  "description": "Curated, source-controlled word lists (PT-BR) for word games.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node pt-br/build.js",
    "lint-curated": "node pt-br/lint-curated.js",
    "candidates": "node pt-br/gen-candidates.js",
    "verb-gap": "node pt-br/gen-verb-candidates.js",
    "verb-gap:network": "node pt-br/fetch-conjugations.js",
    "analyze": "node pt-br/analyze.js",
    "migrate": "node pt-br/migrate-from-entrelinhas.js",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
